{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vitarecord-api-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "api.vitarecord.com/*",
      "zone_name": "vitarecord.com"
    }
  ],
  "vars": {
    "BACKEND_ORIGIN_URL": "http://5.189.141.101:8000",
    "ENVIRONMENT": "production"
  }
}
