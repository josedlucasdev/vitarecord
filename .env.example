# Copiar a .env antes de ejecutar "npm run dev".
# Los valores por defecto usados en docker-compose.yml son SOLO para desarrollo
# local (nunca secretos reales). En producción, todo esto se gestiona vía
# Vault/Secrets Manager (ver plan/plan.md seccion 2.B.10), nunca en este archivo.

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=appcitas
MYSQL_USER=appcitas
MYSQL_PASSWORD=

# Credenciales del almacenamiento S3-compatible local (S3Proxy, ver README.md
# - MinIO dejo de distribuir imagenes Docker gratuitas en oct-2025).
S3_ACCESS_KEY=
S3_SECRET_KEY=

VAULT_DEV_ROOT_TOKEN_ID=

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_NUMBER=
FCM_SERVICE_ACCOUNT_JSON=

SENTRY_DSN=
