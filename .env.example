# Copiar a .env antes de ejecutar "npm run dev".
# Los valores por defecto usados en docker-compose.yml son SOLO para desarrollo
# local (nunca secretos reales). En producción, todo esto se gestiona vía
# Vault/Secrets Manager (ver plan/plan.md seccion 2.B.10), nunca en este archivo.

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=appcitas
MYSQL_USER=appcitas
MYSQL_PASSWORD=

# Credenciales del almacenamiento S3-compatible local (S3Proxy en dev)
S3_ACCESS_KEY=devaccesskey
S3_SECRET_KEY=devsecretkey_dev_only

# Cloudflare R2 Object Storage (Producción / Staging)
# Al configurar R2_ACCOUNT_ID, la app se conectará automáticamente a Cloudflare R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vitarecord-storage
# Dominio público personalizado opcional (ej: https://media.vitarecord.com) o https://pub-xxx.r2.dev
R2_PUBLIC_URL=

VAULT_DEV_ROOT_TOKEN_ID=

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_NUMBER=
FCM_SERVICE_ACCOUNT_JSON=

SENTRY_DSN=
