<footer class="bg-slate-950 text-slate-400 py-16 border-t border-slate-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-800">
      
      <!-- Brand column (Span 2) -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-brand-400 p-0.5 shadow-md">
            <img 
              src="/vitarecord-logo.png" 
              alt="VitaRecord Logo" 
              class="w-full h-full object-contain rounded-[10px] bg-white p-0.5"
            />
          </div>
          <span class="text-2xl font-extrabold text-white tracking-tight">
            Vita<span class="text-brand-400">Record</span>
          </span>
        </a>
        <p class="text-sm text-slate-400 max-w-sm leading-relaxed">
          Plataforma clínica integral para la gestión inteligente de citas, historias clínicas digitales, recetas electrónicas y comunicación con pacientes.
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-slate-800 text-xs font-medium text-slate-300">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Sistemas Operativos 100%</span>
        </div>
      </div>

      <!-- Links: Plataforma -->
      <div class="space-y-3">
        <p class="text-xs font-bold text-white uppercase tracking-wider">Plataforma</p>
        <ul class="space-y-2 text-sm">
          <li><a href="#caracteristicas" class="hover:text-brand-400 transition-colors">Agenda & Citas</a></li>
          <li><a href="#caracteristicas" class="hover:text-brand-400 transition-colors">Historias Clínicas (HCE)</a></li>
          <li><a href="#caracteristicas" class="hover:text-brand-400 transition-colors">Recetas Electrónicas</a></li>
          <li><a href="#caracteristicas" class="hover:text-brand-400 transition-colors">Recordatorios WhatsApp</a></li>
          <li><a href="#seguridad" class="hover:text-brand-400 transition-colors">Seguridad Médica</a></li>
        </ul>
      </div>

      <!-- Links: Empresa -->
      <div class="space-y-3">
        <p class="text-xs font-bold text-white uppercase tracking-wider">Enlaces</p>
        <ul class="space-y-2 text-sm">
          <li><a href="#como-funciona" class="hover:text-brand-400 transition-colors">¿Cómo Funciona?</a></li>
          <li><a href="#planes" class="hover:text-brand-400 transition-colors">Planes & Precios</a></li>
          <li><a href="#faq" class="hover:text-brand-400 transition-colors">Preguntas Frecuentes</a></li>
          <li><a href="https://app.vitarecord.com" class="text-brand-400 hover:text-brand-300 font-semibold transition-colors">Portal de Acceso →</a></li>
        </ul>
      </div>

      <!-- Links: Legal & Contacto -->
      <div class="space-y-3">
        <p class="text-xs font-bold text-white uppercase tracking-wider">Soporte & Contacto</p>
        <ul class="space-y-2 text-sm">
          <li><a href="mailto:soporte@vitarecord.com" class="hover:text-brand-400 transition-colors">soporte@vitarecord.com</a></li>
          <li><a href="https://app.vitarecord.com" class="hover:text-brand-400 transition-colors">Centro de Ayuda</a></li>
          <li><span class="text-slate-500">Términos de Servicio</span></li>
          <li><span class="text-slate-500">Política de Privacidad</span></li>
        </ul>
      </div>

    </div>

    <!-- Bottom copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© 2026 VitaRecord. Todos los derechos reservados.</p>
      <p>Desarrollado para la excelencia en gestión clínica.</p>
    </div>
  </div>
</footer>
