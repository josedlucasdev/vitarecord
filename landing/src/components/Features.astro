---
import { 
  Calendar, 
  MessageSquare, 
  ClipboardList, 
  Pill, 
  ShieldCheck, 
  Check 
} from '@lucide/astro';
---

<section id="caracteristicas" class="py-20 md:py-32 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16 md:mb-20">
      <span class="text-xs sm:text-sm font-bold tracking-widest text-brand-500 uppercase bg-brand-50 px-3.5 py-1.5 rounded-full border border-brand-200">
        Todo en una sola suite clínica
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight">
        Herramientas diseñadas para la <span class="text-gradient">excelencia médica</span>
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
        VitaRecord centraliza cada etapa de la atención clínica, desde la primera reserva de cita hasta el seguimiento médico del paciente.
      </p>
    </div>

    <!-- Bento Grid Showcase -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      
      <!-- Card 1: Agenda & Citas (Span 2 on large) -->
      <div class="lg:col-span-2 group relative rounded-3xl bg-white p-8 sm:p-10 border border-slate-200/90 shadow-sm hover:shadow-xl hover:border-brand-200 transition-all duration-300 overflow-hidden flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center group-hover:scale-110 transition-transform">
            <Calendar class="w-6 h-6 text-brand-600" />
          </div>
          <h3 class="text-2xl font-bold text-slate-900">
            Agenda Médica y Reservas en Tiempo Real
          </h3>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed max-w-xl">
            Permite que tus pacientes agenden su cita médica desde la web sin necesidad de llamar por teléfono. Visualiza tu calendario diario, semanal y mensual con alertas de cruces de horario, gestión de sobrecupos y bloqueos de emergencia.
          </p>
          <div class="pt-3 flex flex-wrap gap-2 text-xs font-semibold text-slate-600">
            <span class="bg-slate-100 px-3 py-1 rounded-full">Reserva web 24/7</span>
            <span class="bg-slate-100 px-3 py-1 rounded-full">Sincronización en vivo</span>
            <span class="bg-slate-100 px-3 py-1 rounded-full">Multisede y multisala</span>
          </div>
        </div>
        
        <!-- Graphical Accent -->
        <div class="mt-8 p-4 rounded-2xl bg-gradient-to-r from-brand-50/80 via-teal-50/40 to-slate-50 border border-brand-100/60 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-white shadow-xs flex items-center justify-center text-brand-500">
              <Check class="w-5 h-5 text-brand-600" />
            </div>
            <div>
              <p class="text-xs font-bold text-slate-800">Cita Confirmada</p>
              <p class="text-[11px] text-slate-500">Dr. Martínez - Ginecología & Obstetricia</p>
            </div>
          </div>
          <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
            100% Sincronizado
          </span>
        </div>
      </div>

      <!-- Card 2: Recordatorios WhatsApp -->
      <div class="group relative rounded-3xl bg-white p-8 sm:p-10 border border-slate-200/90 shadow-sm hover:shadow-xl hover:border-brand-200 transition-all duration-300 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center group-hover:scale-110 transition-transform">
            <MessageSquare class="w-6 h-6 text-emerald-600" />
          </div>
          <h3 class="text-xl font-bold text-slate-900">
            Confirmaciones por WhatsApp
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Reduce el ausentismo hasta en un 65% enviando recordatorios automáticos por WhatsApp con la fecha, hora y ubicación de la consulta.
          </p>
        </div>
        <!-- Animated WhatsApp Chat Mockup -->
        <div class="mt-6 rounded-2xl bg-[#efeae2] border border-[#e1dcd5] p-3.5 overflow-hidden shadow-inner flex flex-col gap-2.5 text-[11px] font-sans">
          
          <!-- WhatsApp Chat Header -->
          <div class="flex items-center justify-between pb-2 border-b border-black/5">
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 rounded-full bg-[#25d366] text-white flex items-center justify-center text-[10px] font-bold shadow-xs">
                VR
              </div>
              <div class="leading-none">
                <p class="font-bold text-slate-800 text-[11px] flex items-center gap-1">
                  <span>VitaRecord</span>
                  <span class="w-3 h-3 rounded-full bg-emerald-500 text-white text-[8px] flex items-center justify-center">✓</span>
                </p>
                <span class="text-[9px] text-emerald-700 font-medium">Cuenta de Empresa</span>
              </div>
            </div>
            <span class="text-[9px] text-slate-400 font-mono">10:00 AM</span>
          </div>

          <!-- Message 1: Bot Reminder -->
          <div class="bg-white rounded-xl rounded-tl-none p-2.5 shadow-xs max-w-[95%] space-y-1.5 border border-black/5">
            <p class="text-slate-800 font-medium leading-tight">
              Hola María, te recordamos tu cita médica de mañana:
            </p>
            <div class="p-1.5 rounded-lg bg-emerald-50/80 border border-emerald-100 text-emerald-900 text-[10px] space-y-0.5">
              <p>• <strong>Dra. Elena Morales</strong> (Ginecología)</p>
              <p>• <strong>3:00 PM</strong> - Consultorio 204</p>
            </div>
            <p class="text-slate-600 text-[10px]">Responde con el número de tu opción:</p>
            <div class="flex gap-1.5 pt-0.5">
              <span class="px-2 py-0.5 rounded bg-emerald-100/70 text-emerald-800 text-[9.5px] font-bold">1. Confirmar</span>
              <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-600 text-[9.5px] font-medium">2. Reagendar</span>
            </div>
            <div class="flex justify-end text-[8px] text-slate-400">10:00 AM</div>
          </div>

          <!-- Message 2: Patient Confirmation Response (Animated) -->
          <div class="self-end bg-[#d9fdd3] rounded-xl rounded-tr-none p-2 shadow-xs max-w-[85%] border border-black/5 animate-chat-patient">
            <div class="flex items-center justify-between gap-2.5">
              <span class="text-slate-800 font-medium text-[10.5px]">1. Sí, confirmo asistencia</span>
              <div class="flex items-center gap-0.5 text-[8px] text-slate-500 shrink-0">
                <span>10:02</span>
                <span class="text-sky-500 font-bold">✓✓</span>
              </div>
            </div>
          </div>

          <!-- Message 3: Bot Final Verification (Animated) -->
          <div class="bg-white rounded-xl rounded-tl-none p-2 shadow-xs max-w-[95%] border border-black/5 animate-chat-bot">
            <div class="flex items-start gap-1.5">
              <span class="text-emerald-500 text-xs font-bold shrink-0">✓</span>
              <p class="text-slate-800 font-medium text-[10px] leading-tight">
                ¡Gracias María! Tu cita quedó <strong>confirmada</strong> en tiempo real en la agenda clínica.
              </p>
            </div>
            <div class="flex justify-end text-[8px] text-slate-400">10:02 AM</div>
          </div>

        </div>
      </div>

      <!-- Card 3: Historias Clínicas Electrónicas -->
      <div class="group relative rounded-3xl bg-white p-8 sm:p-10 border border-slate-200/90 shadow-sm hover:shadow-xl hover:border-brand-200 transition-all duration-300 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-cyan-50 text-cyan-600 flex items-center justify-center group-hover:scale-110 transition-transform">
            <ClipboardList class="w-6 h-6 text-cyan-600" />
          </div>
          <h3 class="text-xl font-bold text-slate-900">
            Historia Clínica Digital (HCE)
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Accede al historial clínico completo de tus pacientes en segundos: antecedentes, evolución médica, diagnósticos, constantes vitales y archivos adjuntos.
          </p>
        </div>
        <div class="mt-6 flex items-center gap-2 text-xs font-semibold text-cyan-700">
          <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
          <span>Búsqueda instantánea de pacientes</span>
        </div>
      </div>

      <!-- Card 4: Recetas y Órdenes Digitales -->
      <div class="group relative rounded-3xl bg-white p-8 sm:p-10 border border-slate-200/90 shadow-sm hover:shadow-xl hover:border-brand-200 transition-all duration-300 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-teal-50 text-teal-600 flex items-center justify-center group-hover:scale-110 transition-transform">
            <Pill class="w-6 h-6 text-teal-600" />
          </div>
          <h3 class="text-xl font-bold text-slate-900">
            Recetas Médicas en PDF
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Genera prescripciones con tu firma y sello médico profesional en formato PDF descargable y listo para imprimir o enviar por correo electrónico.
          </p>
        </div>
        <div class="mt-6 flex items-center gap-2 text-xs font-semibold text-teal-700">
          <span class="w-2 h-2 rounded-full bg-teal-500"></span>
          <span>Vademécum y posología rápida</span>
        </div>
      </div>

      <!-- Card 5: Seguridad y Cifrado Vault -->
      <div class="group relative rounded-3xl bg-white p-8 sm:p-10 border border-slate-200/90 shadow-sm hover:shadow-xl hover:border-brand-200 transition-all duration-300 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center group-hover:scale-110 transition-transform">
            <ShieldCheck class="w-6 h-6 text-indigo-600" />
          </div>
          <h3 class="text-xl font-bold text-slate-900">
            Seguridad Grado Médico
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Cifrado de grado bancario con HashiCorp Vault y Cloudflare R2. Los expedientes de tus pacientes están resguardados bajo los más altos estándares de privacidad.
          </p>
        </div>
        <div class="mt-6 flex items-center gap-2 text-xs font-semibold text-indigo-700">
          <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
          <span>Cifrado AES-256 en reposo y tránsito</span>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  @keyframes chatPatient {
    0%, 15% {
      opacity: 0;
      transform: translateY(10px) scale(0.96);
    }
    22%, 85% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    92%, 100% {
      opacity: 0;
      transform: translateY(6px) scale(0.96);
    }
  }

  @keyframes chatBot {
    0%, 42% {
      opacity: 0;
      transform: translateY(10px) scale(0.96);
    }
    50%, 85% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    92%, 100% {
      opacity: 0;
      transform: translateY(6px) scale(0.96);
    }
  }

  .animate-chat-patient {
    animation: chatPatient 7.5s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  .animate-chat-bot {
    animation: chatBot 7.5s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
</style>
