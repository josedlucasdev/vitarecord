---
---

<section class="relative pt-12 pb-20 md:pt-16 md:pb-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 space-y-8 text-center lg:text-left">

        <!-- Main Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.12]">
          Gestión médica <span class="text-gradient">inteligente y citas online</span> para tu centro de salud.
        </h1>

        <!-- Subtitle -->
        <p class="text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto lg:mx-0 font-normal leading-relaxed">
          Diseñado para consultorios, centros de salud y médicos especialistas. Administra tu agenda, digitaliza historias clínicas, emite recetas electrónicas y reduce inasistencias con recordatorios automáticos por WhatsApp.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a
            href="https://app.vitarecord.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-brand-500 rounded-2xl hover:bg-brand-600 shadow-xl shadow-brand-500/30 hover:shadow-brand-500/40 hover:-translate-y-0.5 transition-all duration-200"
          >
            <span>Ingresar a la Plataforma</span>
            <svg class="w-5 h-5 ml-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>

          <a
            href="#como-funciona"
            class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-4 text-base font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200/80 rounded-2xl shadow-xs hover:border-brand-300 transition-all duration-200"
          >
            <svg class="w-5 h-5 mr-2 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Ver cómo funciona</span>
          </a>
        </div>

        <!-- Trust Mini Badges -->
        <div class="pt-4 flex flex-wrap items-center justify-center lg:justify-start gap-y-2 gap-x-6 text-xs text-slate-500 font-medium">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Cifrado de Grado Médico Vault</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Disponibilidad 99.9% en la Nube</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Sin descargas: 100% Web & Móvil</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Dashboard Mockup & Lottie Animation -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-lg lg:max-w-none">
          
          <!-- Decorative Glow Backdrop -->
          <div class="absolute -inset-1 bg-gradient-to-r from-brand-400 to-cyan-400 rounded-3xl blur-2xl opacity-25"></div>

          <!-- Main Interactive Card Frame -->
          <div class="relative rounded-3xl bg-white border border-slate-200/90 shadow-2xl p-6 sm:p-7 overflow-hidden space-y-6">
            
            <!-- Window header bar -->
            <div class="flex items-center justify-between pb-4 border-b border-slate-100">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-rose-400 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-amber-400 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-400 inline-block"></span>
                <span class="text-xs font-semibold text-slate-400 ml-2 font-mono">app.vitarecord.com</span>
              </div>
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-brand-50 text-brand-600">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-500 animate-pulse"></span>
                En Línea
              </span>
            </div>

            <!-- Lottie Animation Container -->
            <div class="relative w-full h-56 sm:h-64 flex items-center justify-center rounded-2xl bg-gradient-to-b from-brand-50/60 to-slate-50/40 p-4 border border-brand-100/50">
              <!-- Interactive Calendar Lottie Animation -->
              <dotlottie-player
                src="/CALENDER.lottie"
                background="transparent"
                speed="1"
                class="w-full h-full object-contain"
                loop
                autoplay
              ></dotlottie-player>

              <!-- Floating Micro-badge: Cita Agendada -->
              <div class="absolute top-3 left-3 bg-white/90 backdrop-blur-md px-3 py-1.5 rounded-xl border border-slate-100 shadow-md flex items-center gap-2 animate-float">
                <div class="w-6 h-6 rounded-lg bg-brand-100 text-brand-600 flex items-center justify-center">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <p class="text-[10px] text-slate-400 font-medium">Próxima Consulta</p>
                  <p class="text-xs font-bold text-slate-800">Hoy, 10:30 AM</p>
                </div>
              </div>

              <!-- Floating Micro-badge: WhatsApp Confirmación -->
              <div class="absolute bottom-3 right-3 bg-white/90 backdrop-blur-md px-3 py-1.5 rounded-xl border border-slate-100 shadow-md flex items-center gap-2">
                <div class="w-6 h-6 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center">
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.181-.076.355.101.173.449.741.964 1.2.662.591 1.221.774 1.394.86.173.086.275.072.376-.043.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.044.072.044.419-.1.824z" />
                  </svg>
                </div>
                <div>
                  <p class="text-[10px] text-slate-400 font-medium">Recordatorio</p>
                  <p class="text-xs font-bold text-emerald-600">WhatsApp Enviado</p>
                </div>
              </div>

            </div>

            <!-- Quick Mockup Metrics Row -->
            <div class="grid grid-cols-3 gap-3 pt-2">
              <div class="p-3 rounded-2xl bg-slate-50 border border-slate-100 text-center">
                <span class="block text-xs text-slate-400 font-medium">Citas Hoy</span>
                <span class="text-lg font-bold text-slate-800">18</span>
              </div>
              <div class="p-3 rounded-2xl bg-brand-50/50 border border-brand-100 text-center">
                <span class="block text-xs text-brand-600 font-medium">Atendidas</span>
                <span class="text-lg font-bold text-brand-700">14</span>
              </div>
              <div class="p-3 rounded-2xl bg-slate-50 border border-slate-100 text-center">
                <span class="block text-xs text-slate-400 font-medium">En Espera</span>
                <span class="text-lg font-bold text-slate-800">4</span>
              </div>
            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</section>
